# ==============================================================================
# LYORA Learning Management Platform - Production Backend Environment
# A Product by Solvia Nova
# ==============================================================================

APP_NAME="LYORA"
APP_ENV=production
APP_KEY=base64:aHK29LDWbTc0QsQvNA+Hq18XIqO2PlLHxjYUNihcuFw=
APP_DEBUG=false
APP_URL=https://api.lyora.solvianova.com
FRONTEND_URL=https://lyora.solvianova.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Logging & Monitoring
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database Configuration (MySQL 8.0+ on Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyora_production_db
DB_USERNAME=lyora_db_user
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuat_2026!

# Sessions & Cache (Redis recommended for VPS / Cloud)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=redis
CACHE_PREFIX=lyora_cache_

# Queue & Background Workers
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Notification Service (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@lyora.solvianova.com
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@lyora.solvianova.com"
MAIL_FROM_NAME="LYORA Notification"

# LiveKit Cloud Ephemeral Video Room SDK (Section 7.6)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_HOST=https://lyora-live.livekit.cloud

# S3-Compatible Object Storage (AWS S3, Wasabi, or MinIO)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_s3_access_key
AWS_SECRET_ACCESS_KEY=your_s3_secret_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=lyora-storage-prod
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
