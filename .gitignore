# ==========================================
# LYORA - .gitignore
# Solvia Nova EdTech Platform
# ==========================================

# Dependencies
/backend/vendor/
/frontend/node_modules/
node_modules/

# Environment files with sensitive credentials
/backend/.env
/backend/.env.backup
/backend/.env.production
/frontend/.env*.local
/frontend/.env

# Next.js build output & cache
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/*.tsbuildinfo

# Laravel build & caches
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/.phpunit.cache
/backend/.phpunit.result.cache

# Deployment Private Keys (DO NOT COMMIT SECRETS)
/deploy/lyora_deploy_key
/deploy/lyora_rsa_deploy_key
*.pem
*.key
id_rsa
id_ed25519

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
